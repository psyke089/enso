<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system fixes its icon at screen center. Compose places the Enso at its timer bounds. -->
    <style name="Theme.Enso.Splash" parent="Theme.Enso">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/paper</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
