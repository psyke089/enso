<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the Enso brush on washi paper. -->
    <style name="Theme.Enso.Splash" parent="Theme.Enso">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/enso_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/paper</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
