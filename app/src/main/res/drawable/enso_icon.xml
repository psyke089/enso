<?xml version="1.0" encoding="utf-8"?>
<!-- Reuse the splash ink. Its 2/3-width motif becomes 66dp within the 108dp
     adaptive layer, keeping the brush inside Android's safe masking region. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4.17%" android:insetTop="4.17%"
    android:insetRight="4.17%" android:insetBottom="4.17%">
    <bitmap android:src="@drawable/native_splash_enso" android:gravity="fill" />
</inset>
