#!/usr/bin/env bash
# Local and CI verification gate for Enso.
set -euo pipefail

cd "$(dirname "$0")/.."

jdk=${JAVA_HOME:-/usr/lib/jvm/java-21-openjdk}
if [[ -x $jdk/bin/java ]]; then
  export JAVA_HOME=$jdk
  export PATH=$JAVA_HOME/bin:$PATH
fi

exec ./gradlew --no-daemon testDebugUnitTest lintDebug assembleDebug "$@"
